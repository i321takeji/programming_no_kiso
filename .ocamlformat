profile = ocamlformat
# break-cases = fit
# break-cases = vertical
break-cases = all
if-then-else=vertical
# if-then-else={compact|fit-or-vertical|vertical|keyword-first|k-r}
space-around-records=true
field-space=loose
# field-space={loose|tight|tight-decl}
margin = 77
wrap-comments = true
line-endings = lf
parens-tuple = always
parens-tuple-patterns = always
# indicate-nested-or-patterns={unsafe-no|space}
indicate-nested-or-patterns=unsafe-no
# To make ocaml-ci happy
version = ignore
version-check = false